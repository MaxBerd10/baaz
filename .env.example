# ==== Telegram bot ====
# @BotFather dan olingan token
BOT_TOKEN=123456:ABCDEF

# Bootstrap adminlar — Telegram user id lar, vergul bilan.
# Bu id lar botga /start bosганда avtomat admin bo'ladi.
ADMIN_TELEGRAM_IDS=111111111,222222222

# ==== Ma'lumotlar bazasi ====
# Lokal ishga tushirish uchun (hech narsa o'rnatish shart emas):
DATABASE_URL=sqlite+aiosqlite:///./baaz.db
# Docker / production uchun:
# DATABASE_URL=postgresql+asyncpg://baaz:baaz@db:5432/baaz

# ==== Media (rasm/video) ====
MEDIA_ROOT=./media

# ==== Rahbar web-panel ====
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_PASSWORD=admin
SECRET_KEY=almashtiring-meni-uzun-tasodifiy-satrga

# ==== Boshlang'ich sozlama ====
DEFAULT_STAGE_COUNT=7
TIMEZONE=Asia/Tashkent
