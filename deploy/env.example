# --- Web panel shu serverda faqat 127.0.0.1:WEB_PORT da ochiladi ---
# Cloudflare Tunnel: hostname -> http://localhost:8090  (tavsiya)
WEB_PORT=8090
# Faqat Caddy (`--profile caddy`) ishlatilsa kerak; A-yozuv shu serverning IP'siga qaragan bo'lishi kerak
# DOMAIN=panel.example.uz

# --- Telegram bot ---
BOT_TOKEN=
# Admin Telegram ID'lari — MAJBURAN JSON ro'yxat ko'rinishida: [123456789] yoki [111,222]
ADMIN_IDS=[123456789]

# --- Postgres (parolda faqat harf/raqam ishlating: bot uni URL ichiga qo'yadi) ---
POSTGRES_USER=truckbot
POSTGRES_PASSWORD=
POSTGRES_DB=truck_factory

# --- Web panel ---
WEB_PASSWORD=
# uzun tasodifiy qator: openssl rand -hex 32
SECRET_KEY=

TZ=Asia/Tashkent

# Ixtiyoriy: botning lokal nusxasidan qurish (standart — GitHub)
# BOT_SRC=../../truck-factory-bot
